{
  "expo": {
    "name": "Discipulado JNI",
    "slug": "discipulado-jni",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "discipulado",
    "icon": "./assets/icon.png",
    "backgroundColor": "#000000",
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "android": {
      "package": "br.org.jniuniao.discipulado",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}